# ---- Core ----
NODE_ENV=development
APP_URL=http://localhost:3000

# ---- LLM Provider (NVIDIA NIM OpenAI-compatible) ----
LLM_API_KEY=nvapi-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Per-feature model routing
MODEL_CHAT=meta/llama-3.1-70b-instruct
MODEL_SUMMARIZE=meta/llama-3.1-70b-instruct
MODEL_TRANSLATE=meta/llama-3.1-8b-instruct
MODEL_SLIDES=meta/llama-3.1-70b-instruct
MODEL_SPEECH_SCRIPT=meta/llama-3.1-8b-instruct
MODEL_CODE=meta/llama-3.1-70b-instruct

# ---- Backward compatibility aliases (optional) ----
# KIMI_API_KEY=
# KIMI_BASE_URL=
# KIMI_DEFAULT_MODEL=
# NVIDIA_API_KEY=
# NVIDIA_BASE_URL=

# ---- Auth (Clerk) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Database (Postgres + pgvector) ----
DATABASE_URL=postgres://user:pass@host:5432/kimi_suite

# ---- Redis (Upstash) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Object Storage (Cloudflare R2 / S3 compatible) ----
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=kimi-suite
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- TTS (ElevenLabs) ----
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE=21m00Tcm4TlvDq8ikWAM

# ---- Billing (Stripe) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=

# ---- Observability ----
SENTRY_DSN=
AXIOM_TOKEN=
AXIOM_DATASET=kimi-suite

# ---- Feature flags / analytics ----
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
