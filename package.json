{
  "name": "kimi-suite",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"@kimi/web\" --filter \"@kimi/worker\" run dev",
    "dev:turbo": "turbo run dev",
    "dev:web": "pnpm --filter @kimi/web dev",
    "dev:worker": "pnpm --filter @kimi/worker dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "pnpm": "^9.15.0",
    "turbo": "^2.10.5",
    "typescript": "^5.6.3"
  }
}
