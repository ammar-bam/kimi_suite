{
  "name": "kimi-suite",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"@kimi/web\" --filter \"@kimi/worker\" run dev",
    "dev:turbo": "turbo run dev",
    "dev:web": "pnpm --filter @kimi/web dev",
    "dev:worker": "pnpm --filter @kimi/worker dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:generate": "pnpm --filter @kimi/db db:generate",
    "db:migrate": "pnpm --filter @kimi/db db:migrate",
    "db:push": "pnpm --filter @kimi/db db:push",
    "db:studio": "pnpm --filter @kimi/db db:studio"
  },
  "devDependencies": {
    "pnpm": "^9.15.0",
    "turbo": "^2.10.5",
    "typescript": "^5.6.3"
  }
}
